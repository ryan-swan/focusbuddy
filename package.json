{
  "name": "focusbuddy",
  "version": "2.5.7",
  "private": true,
  "description": "Task-scoped digital work environment for people with ADHD and high distractibility.",
  "main": "./out/main/index.js",
  "author": "michael@saasmouth.agency",
  "scripts": {
    "dev": "node scripts/dev.cjs dev",
    "build": "electron-vite build",
    "preview": "node scripts/dev.cjs preview",
    "start": "node scripts/dev.cjs preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "rebuild": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder --mac --publish never",
    "dist:zip": "npm run build && electron-builder --mac zip --publish never",
    "dist:release": "npm run build && electron-builder --mac zip --publish always",
    "rebuild:win": "electron-rebuild -f -w better-sqlite3",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:win:release": "npm run build && electron-builder --win --publish always",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "engines": {
    "node": ">=20.0.0 <23.0.0"
  },
  "overrides": {
    "node-gyp": "^11.2.0",
    "@electron/node-gyp": "10.2.0-electron.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/extension-task-item": "^3.23.6",
    "@tiptap/extension-task-list": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "@xenova/transformers": "^2.17.2",
    "@xyflow/react": "^12.11.0",
    "better-sqlite3": "^11.5.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.3",
    "perfect-freehand": "^1.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.7",
    "react-rnd": "^10.4.13",
    "remark-gfm": "^4.0.1",
    "tiptap-markdown": "^0.9.0",
    "zustand": "^5.0.1"
  },
  "optionalDependencies": {
    "node-mac-haptics": "^1.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@playwright/test": "^1.60.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/expect": "^4.1.7",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "@electron/rebuild": "^3.7.2",
    "electron-vite": "^2.3.0",
    "happy-dom": "^20.9.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^4.1.7"
  }
}
