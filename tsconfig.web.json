{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/**/*",
    "src/preload/index.d.ts",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    // No baseUrl (deprecated): paths below resolve relative to this tsconfig,
    // which is the project root — identical to the old `baseUrl: "."`.
    // moduleResolution "bundler" replaces the base config's deprecated node10
    // (correct for Vite); together these drop the need for ignoreDeprecations.
    "moduleResolution": "bundler",
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@shared/*": ["./src/shared/*"],
      "@office": ["./src/renderer/src/office/index.ts"],
      "@runtime": ["./src/renderer/src/runtime/index.ts"]
    }
  }
}
